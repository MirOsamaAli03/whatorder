# ---------------------------------------------------------------------------
# Restaurant OS — production deployment
#
# Copy to .env.production, fill in, and keep it out of version control.
# Used by: docker compose -f infrastructure/docker/docker-compose.prod.yml \
#            --env-file .env.production up -d
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Domains ----------------------------------------------------------------
# Both must already resolve to this machine: certificates are issued by HTTP
# challenge and will fail otherwise.
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=dashboard.example.com

# The same two, as origins. API_ORIGIN is compiled into the browser bundle at
# image build time, so changing it later needs a rebuild rather than a restart.
API_ORIGIN=https://api.example.com
DASHBOARD_ORIGIN=https://dashboard.example.com

# --- Database ---------------------------------------------------------------
# Three roles, three passwords. The application connects as restaurant_app,
# which cannot bypass Row-Level Security; the owner is used only for migrations.
#
# These are applied when the database volume is first created. Rotating one
# afterwards means an ALTER ROLE as well — see docs/DEPLOYMENT.md.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_WORKER_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Must differ from each other: sharing one secret means an access token can be
# replayed as a refresh token, which defeats rotation and reuse detection.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- WhatsApp ---------------------------------------------------------------
# Meta's app secret. Every inbound webhook is verified against it by HMAC. The
# API refuses to start without it in this compose file, deliberately: accepting
# unverified callbacks lets anyone who finds the URL forge a customer's message.
WHATSAPP_WEBHOOK_SECRET=

# Echoed back during Meta's one-time subscription handshake. Any unguessable
# string; it only has to match what is entered in the Meta console.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Optional ---------------------------------------------------------------
LOG_LEVEL=info
