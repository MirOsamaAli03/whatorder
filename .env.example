# ---------------------------------------------------------------------------
# Restaurant OS — environment configuration
# Copy to .env and fill in. Every variable here is validated at boot by
# apps/api/src/config/env.schema.ts; the process exits if any are missing.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# DATABASE_URL      : the APPLICATION role. Non-superuser, not the table owner,
#                     and WITHOUT bypassrls. Row-Level Security is enforced on
#                     this connection. All runtime queries use it.
# DATABASE_URL_ADMIN: the MIGRATION/owner role. Owns the schema and bypasses
#                     RLS. Used only by prisma migrate and the seed script.
# Keeping these separate is what makes RLS a real second line of defence:
# if application code forgets a tenant filter, the database still returns nothing.
DATABASE_URL=postgresql://restaurant_app:app_password@127.0.0.1:5432/restaurant_os?schema=public
DATABASE_URL_ADMIN=postgresql://restaurant_owner:owner_password@127.0.0.1:5432/restaurant_os?schema=public
# DATABASE_URL_WORKER: the background worker. Narrower than either of the
# above: policies on outbox_events, organizations, branches, orders,
# order_escalations and outbox_cursors, plus three scheduling COLUMNS of
# notifications — and nothing else. It needs to look across tenants to drain the
# outbox, which the app role cannot do.
#
# The worker process reads DATABASE_URL as well, and uses it for every
# tenant-scoped step: sending a notification needs a customer's phone number,
# which the worker role is deliberately refused at the database.
DATABASE_URL_WORKER=postgresql://restaurant_worker:worker_password@127.0.0.1:5432/restaurant_os?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- API --------------------------------------------------------------------
PORT=3001
LOG_LEVEL=debug
# Browser origins allowed to call the API with credentials.
#
# Both loopback spellings are listed on purpose: to a browser
# http://localhost:3000 and http://127.0.0.1:3000 are DIFFERENT origins, and a
# request from the one that is missing fails CORS with a message that looks
# like the API is down rather than like a configuration problem.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These MUST differ from each other and must be rotated per environment.
JWT_ACCESS_SECRET=change_me_dev_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- WhatsApp (Phase 5) -----------------------------------------------------
# Meta's app secret. Every inbound webhook is verified by HMAC-SHA256 over the
# raw request body against this value.
#
# Optional, and unset here on purpose: with no secret the check is skipped so
# that development works without a Meta app, and a warning is logged on every
# request so it cannot reach a deployment unnoticed. Set it before connecting a
# real number — without it, anyone who finds the URL can mark messages delivered
# or, from Phase 6, forge a message from a customer.
# WHATSAPP_WEBHOOK_SECRET=
#
# Echoed back during Meta's one-time subscription handshake. Any sufficiently
# unguessable string; it only has to match what is entered in the Meta console.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Worker (Phase 4, 5) ----------------------------------------------------
# Poll intervals, in milliseconds. Defaults shown; all optional.
# WORKER_OUTBOX_POLL_MS=500
# WORKER_ESCALATION_POLL_MS=5000
# WORKER_NOTIFICATION_DISPATCH_POLL_MS=1000
# WORKER_NOTIFICATION_SEND_POLL_MS=1000
# WORKER_NOTIFICATION_BATCH_SIZE=25
# How long a notification may sit PROCESSING before another worker reclaims it.
# WORKER_NOTIFICATION_STALE_CLAIM_MS=120000

# --- Rate limiting (spec 67) ------------------------------------------------
# Sign-in attempts per minute, per client IP.
#
# Every member of staff in a restaurant shares one NAT-ed address, so a tight
# per-IP budget locks out a whole shift rather than an attacker. Brute force
# against a specific account is already handled separately and more precisely,
# by the per-account lockout in AuthService (10 failed attempts, 15 minutes).
# This limit exists for volumetric abuse, so it can afford to be generous.
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=120
